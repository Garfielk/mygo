package main

// A folder of frosted glass: a blue back with a tab, a light sheet in it,
// and the front, a pane of frosted glass hinged at its bottom, which tips
// toward the camera as the folder opens. What is behind the pane shows
// through it blurred, and the pane's lower part blurs too, progressively,
// until the folder opens and the glass comes into focus.
//
// The scene is laid out in units of the video it recreates, 1080 pixels
// square, from its middle, y down; Unit is how many of them make a DIP.
// Every blur is of shapes known here, rectangles, so a pixel computes its
// blurred colors in one pass, exactly, rather than averaging its
// neighbors.

// Angle is how far the pane has tipped, in radians.
var Angle float

// Clear is how clear the glass is, from 0, frosted, to 1, as the open
// folder shows it.
var Clear float

// Focus moves the progressive blur down the pane, from 0, closed, to 1,
// open: how far from its top the pane starts to blur, in units, is
// focusFrom to focusTo.
var Focus float

// Unit is the units of the scene a DIP.
var Unit float

const (
	// The camera is camera units from the hinge, its eye level with the
	// pane's top when closed, eye.
	camera = 2074.0
	eye    = -135.0

	// The back: its sides, the top of its tab and of its body, its bottom,
	// and the radius of its corners, top and bottom. The tab's top slopes
	// down to the body's through (slopeX, slopeY). The sheet in it.
	backHalf    = 230.0
	tabTop      = -189.0
	bodyTop     = -148.0
	backBottom  = 146.0
	backRadius  = 44.0
	bottomRound = 120.0
	slopeX      = -25.5
	slopeY      = -169.0
	slope       = 0.6
	sheetHalfW  = 177.0
	sheetTop    = -70.0
	sheetBottom = 88.0
	sheetRound  = 50.0

	// The pane: half its width, its height above the hinge and below it,
	// which shows taller as the glass comes into focus, its corners'
	// radius.
	paneHalf   = 246.0
	paneHeight = 275.0
	belowFrom  = 65.0
	belowTo    = 100.0
	paneRadius = 30.0
	hinge      = 140.0

	// How much the pane's lower part blurs: from focusFrom (closed) or
	// focusTo (open) below its top, more and more, to blurMost.
	focusFrom = 45.0
	focusTo   = 235.0
	blurMost  = 50.0
	blurReach = 150.0

	// How much the glass blurs what is behind it, frosted and clear.
	frostedBlur = 90.0
	clearBlur   = 12.0
)

// cdf is the standard normal distribution: how much of a shape a
// Gaussian blur keeps at a signed distance of x deviations inside its
// edge.
func cdf(x float) float {
	x = clamp(x, -8, 8)
	return 1 / (1 + exp(-1.5976*x-0.070566*x*x*x))
}

// band is how much of [lo, hi] a blur of deviation s covers at x.
func band(x, lo, hi, s float) float {
	return cdf((x-lo)/s) - cdf((x-hi)/s)
}

// box is how much of a rectangle from lo to hi a blur of deviation s
// covers at p.
func box(p, lo, hi vec2, s float) float {
	return band(p.x, lo.x, hi.x, s) * band(p.y, lo.y, hi.y, s)
}

// roundedBox is box with corners of radius r: the blurred distance to
// them where the blur is small next to the rectangle, as at its corners.
func roundedBox(p, lo, hi vec2, r, s float) float {
	return min(box(p, lo, hi, s), cdf(-roundBox(p, 0.5*(lo+hi), 0.5*(hi-lo), r)/s))
}

// roundBox returns the distance from p to a rectangle centered at c with
// half size h and corners of radius r: below zero inside.
func roundBox(p, c, h vec2, r float) float {
	q := abs(p-c) - h + r
	return length(max(q, 0)) + min(max(q.x, q.y), 0) - r
}

// roundIntersect intersects the shapes at distances a and b, rounding
// the corners where their edges meet by r.
func roundIntersect(a, b, r float) float {
	u := max(vec2(r+a, r+b), 0)
	return min(-r, max(a, b)) + length(u)
}

// background is the page's: near white, a little bluer in the middle.
func background(p vec2) vec3 {
	return mix(vec3(0.929, 0.939, 0.994), vec3(0.969, 0.973, 0.998), smoothstep(250, 560, length(p)))
}

// backColor is the back's blue at the height y: light at the top of the
// tab, deeper down, and indigo at the bottom.
func backColor(y float) vec3 {
	c := mix(vec3(0.667, 0.824, 0.992), vec3(0.333, 0.502, 0.984), clamp((y+178)/94, 0, 1))
	return mix(c, vec3(0.25, 0.30, 0.96), clamp((y+84)/124, 0, 1))
}

// smin and smax are min and max rounded where a and b meet, over k.
func smin(a, b, k float) float {
	h := clamp(0.5+0.5*(b-a)/k, 0, 1)
	return mix(b, a, h) - k*h*(1-h)
}

func smax(a, b, k float) float {
	h := clamp(0.5+0.5*(a-b)/k, 0, 1)
	return mix(b, a, h) + k*h*(1-h)
}

// back returns the distance to the back's outline, and to its top edge,
// whose rim catches the light: the tab's top, a slope down, and the
// body's top, joined by curves.
func back(p vec2) (float, float) {
	line := slopeY + slope*(p.x-slopeX)
	top := smax(smin(line, bodyTop, 7), tabTop, 7)
	steep := 0.0
	if top > tabTop+1 && top < bodyTop-1 {
		steep = slope
	}
	dTop := (top - p.y) / sqrt(1+steep*steep)
	sides := roundBox(p, vec2(0, -80), vec2(backHalf, backBottom+80), backRadius)
	return roundIntersect(dTop, sides, backRadius), dTop
}

// behind is what the pane covers at p, blurred by s: the background, the
// back and the sheet in it, a little grayer than the page.
func behind(p vec2, s float) vec3 {
	tab := box(p, vec2(-backHalf, tabTop), vec2(slopeX, bodyTop), s)
	body := roundedBox(p, vec2(-backHalf, bodyTop), vec2(backHalf, backBottom), bottomRound, s)
	sheet := roundedBox(p, vec2(-sheetHalfW, sheetTop), vec2(sheetHalfW, sheetBottom), sheetRound, s)
	c := mix(background(p), backColor(p.y), clamp(tab+body, 0, 1))
	return mix(c, background(p)-vec3(0.09, 0.08, 0.01), sheet)
}

func Fragment(dst vec4, pos vec2) vec4 {
	p := (pos - 0.5*rectSize()) * Unit
	// A pixel, in units, the least an edge blurs by.
	aa := 0.45 * Unit / pixelScale()

	// The pane: where the ray through the pixel meets it, across it (u)
	// and down from its top (v), and how many units of the screen a unit
	// of the pane covers, across (kx) and down (ky).
	s, c := sin(Angle), cos(Angle)
	a := (p.y - eye) / camera
	h := (hinge - eye - a*camera) / (c - a*s)
	z := camera - h*s
	u := p.x * z / camera
	v := paneHeight - h
	kx := camera / z
	ky := camera * abs(c*camera-(hinge-eye)*s) / (z * z)

	// The progressive blur, from where it starts down the pane, which
	// blurs what is around the pane there too.
	start := mix(focusFrom, focusTo, Focus)
	blur := blurMost * (1 - exp(-max(v-start, 0)/blurReach))
	edge := max(blur, aa)

	// The background, and the back where it shows above the pane: the
	// blur blurs what the eye sees, which is the pane below.
	col := background(p)
	d, dTop := back(p)
	if d < 4*edge && v < 4*edge {
		// Its bevel: along the top, a dark line at the edge and a bright
		// one inside, lit from above, and down the sides, a shade.
		inside := max(-d, 0)
		up := clamp(1-(max(-dTop, 0)-inside)/8, 0, 1)
		b := backColor(p.y)
		b += up * (vec3(0.09, 0.08, 0)*exp(-(inside-6.5)*(inside-6.5)/6) - vec3(0.05, 0.04, 0)*exp(-(inside-2.5)*(inside-2.5)/1.7))
		b -= (1 - up) * vec3(0.035, 0.03, 0) * exp(-inside/10)
		col = mix(col, b, cdf(-d/edge)*cdf(-v*ky/edge))
	}

	tall := paneHeight + mix(belowFrom, belowTo, Focus)
	across := cdf((paneHalf - abs(u)) * kx / edge)
	down := cdf(v*ky/edge) * cdf((tall-v)*ky/edge)
	k := 0.5 * (kx + ky)
	sd := roundBox(vec2(u, v), vec2(0, 0.5*tall), vec2(paneHalf, 0.5*tall), paneRadius) * k
	cover := min(across*down, cdf(-sd/edge))
	if cover < 0.002 {
		return vec4(col, 1)
	}

	// The glass: milky, over what is behind it blurred, frosted or clear,
	// and by the progressive blur.
	frost := mix(frostedBlur, clearBlur, Clear)
	milk := mix(vec3(0.75, 0.84, 0.988), vec3(0.742, 0.842, 0.992), Clear)
	// Lit from above, its top is lighter.
	milk += vec3(0.035, 0.025, 0) * (0.5 - v/paneHeight)
	g := mix(behind(p, sqrt(frost*frost+blur*blur)), milk, mix(0.92, 0.77, Clear))
	// Its rim: a dark hairline at the edge, a bright one inside.
	w := sqrt(1.2*1.2 + blur*blur)
	line := 1.2 / w
	g = mix(g, vec3(0.55, 0.62, 0.90), 0.45*line*exp(-0.5*(sd+0.8)*(sd+0.8)/(w*w)))
	g = mix(g, vec3(0.85, 0.90, 1), 0.55*line*exp(-0.5*(sd+3.5)*(sd+3.5)/(w*w)))
	return vec4(mix(col, g, cover), 1)
}
